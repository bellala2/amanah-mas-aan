APP_ENV=development
PORT=8080
DATABASE_URL=postgres://amanah:amanah@localhost:5432/amanah?sslmode=disable
JWT_SECRET=ganti-dengan-random-string-minimal-32-karakter
OTP_SECRET=ganti-dengan-random-string-lain-minimal-32-karakter

ACCESS_TTL=15m
REFRESH_TTL=24h
REFRESH_TTL_REMEMBER=720h
RESET_TOKEN_TTL=10m

OTP_TTL=5m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION=15m
BCRYPT_COST=12

# true = OTP ikut dikembalikan di response & dicetak di log (HANYA untuk development/testing)
DEBUG_OTP=true
